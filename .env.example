# Copy to .env on the companion server and replace every placeholder.
# Keep it readable only by the deployment user (chmod 600 .env).
# If CPA is on this host and CPA_BASE_URL uses 127.0.0.1, either copy
# compose.server.yml to docker-compose.override.yml or uncomment this line.
# COMPOSE_FILE=docker-compose.yml:compose.server.yml
PUBLIC_URL=https://companion.example.com
LINUXDO_CLIENT_ID=replace-me
LINUXDO_CLIENT_SECRET=replace-me
# Minimum Linux DO trust level allowed to sign in (1-4, default 2).
LINUXDO_MIN_TRUST_LEVEL=2
ADMIN_SUBJECTS=
# Optional GitHub link in the sidebar footer; leave empty to hide it.
GITHUB_URL=

# Existing CPA root URL, reachable from the companion container.
# The proxy API key and management key are different.
# Container localhost is not the CPA host. Use HTTPS or a private IP over HTTP.
CPA_BASE_URL=https://cpa.example.com
CPA_API_KEY=replace-with-cpa-proxy-api-key
CPA_MANAGEMENT_KEY=replace-with-cpa-management-key
# Optional extra first segments not reported by CPA's OAuth model alias API.
CPA_MODEL_ALIAS_PREFIXES=
# How long API routing reuses CPA account data (Go duration, 0s-30m; 0s disables).
CPA_ACCOUNT_CACHE_TTL=15s
